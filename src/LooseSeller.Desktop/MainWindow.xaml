<Window x:Class="LooseSeller.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Loose Seller"
        Icon="/logo.png"
        Width="1180" Height="760"
        MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#100D1B"
        Foreground="#F8F5FF">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="MutedBrush" Color="#A69BBD" />
        <SolidColorBrush x:Key="PanelBrush" Color="#19142A" />
        <SolidColorBrush x:Key="BorderBrush" Color="#30254A" />

        <RadialGradientBrush x:Key="PageGradient"
                             Center="1,0"
                             GradientOrigin="1,0"
                             RadiusX="1.15"
                             RadiusY="1.15">
            <GradientStop Color="#3B1464" Offset="0" />
            <GradientStop Color="#100D1B" Offset="0.38" />
            <GradientStop Color="#100D1B" Offset="1" />
        </RadialGradientBrush>

        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7C3AED" Offset="0" />
            <GradientStop Color="#E11D8D" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="HeaderScrollThumb" TargetType="Thumb">
            <Setter Property="Background" Value="#29223C" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="#0D0A15" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" IsHitTestVisible="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Margin="1,2"
                                           Style="{StaticResource HeaderScrollThumb}"
                                           FocusVisualStyle="{x:Null}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" IsHitTestVisible="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0F0C18" />
            <Setter Property="Foreground" Value="#F8F5FF" />
            <Setter Property="CaretBrush" Value="#E11D8D" />
            <Setter Property="BorderBrush" Value="#30254A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,6,0,14" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="#D98DFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="#D98DFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#D98DFF" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#D98DFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#29223C" />
            <Setter Property="Foreground" Value="#F8F5FF" />
            <Setter Property="BorderBrush" Value="#30254A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#D98DFF" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#D98DFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#B51673" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentGradient}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="190" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="8,0" />
        </Style>

        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#C7BED6" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionButtonBorder" Property="Background" Value="#D98DFF" />
                                <Setter TargetName="CaptionButtonBorder" Property="BorderBrush" Value="#D98DFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionButtonBorder" Property="Background" Value="#B875D9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D98DFF" />
                    <Setter Property="Foreground" Value="#100D1B" />
                    <Setter Property="BorderBrush" Value="#D98DFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B875D9" />
                    <Setter Property="Foreground" Value="#100D1B" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#0F0C18" />
            <Setter Property="Foreground" Value="#F8F5FF" />
            <Setter Property="BorderBrush" Value="#30254A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="#0F0C18" />
            <Setter Property="Foreground" Value="#F8F5FF" />
            <Setter Property="Padding" Value="8" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource PageGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="70" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#0D0A15"
                BorderBrush="#241A38"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}"
                            Content="—"
                            Click="MinimizeButton_Click" />
                    <Button Style="{StaticResource CaptionButton}"
                            Content="□"
                            Click="MaximizeButton_Click" />
                    <Button Style="{StaticResource CaptionButton}"
                            Content="×"
                            FontSize="18"
                            Click="CloseButton_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                    <Image Source="/logo.png" Width="18" Height="18" VerticalAlignment="Center" />
                    <TextBlock Text="Loose Seller"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#C7BED6" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Background="#121020"
                BorderBrush="#30254A"
                BorderThickness="0,0,0,1">
            <Grid Margin="28,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42"
                            CornerRadius="10"
                            Background="#211936"
                            Padding="5">
                        <Image Source="/logo.png" Stretch="Uniform" />
                    </Border>
                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LOOSE SELLER"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White" />
                        <TextBlock Text="Preparador de produtos 3D"
                                   Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2"
                      Background="Transparent"
                      BorderThickness="0"
                      BorderBrush="Transparent"
                      FocusVisualStyle="{x:Null}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Novo produto"
                           FontSize="28"
                           FontWeight="SemiBold" />
                <TextBlock Grid.Row="1"
                           Text="Organize seus arquivos e deixe o anúncio pronto em poucos passos."
                           Margin="0,5,0,20"
                           Foreground="{StaticResource MutedBrush}" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="0.9*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="22">
                        <StackPanel>
                            <TextBlock Text="INFORMAÇÕES DO PRODUTO"
                                       Foreground="#D98DFF"
                                       FontSize="10"
                                       FontWeight="Bold" />
                            <TextBlock Text="Dados básicos"
                                       Margin="0,6,0,18"
                                       FontSize="19"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="Diretório de saída *" FontWeight="SemiBold" />
                            <Grid Margin="0,6,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ProductsDirectoryTextBox" IsReadOnly="True" Margin="0" />
                                <Button Grid.Column="1" Content="Procurar" Margin="10,0,0,0" Click="SelectProductsDirectoryButton_Click" />
                            </Grid>

                            <TextBlock Text="Título do produto *" FontWeight="SemiBold" />
                            <TextBox x:Name="TitleTextBox" ToolTip="Digite o título do produto" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Material" FontWeight="SemiBold" />
                                    <TextBox x:Name="MaterialTextBox" Text="PLA" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Dias sob encomenda" FontWeight="SemiBold" />
                                    <TextBox x:Name="MadeToOrderDaysTextBox" Text="4" IsReadOnly="True" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Referência" FontWeight="SemiBold" />
                                    <TextBox x:Name="ReferenceTextBox" MaxLength="6" Text="LA" ToolTip="Formato: LA0000" PreviewTextInput="ReferenceTextBox_PreviewTextInput" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Medidas em centímetros" FontWeight="SemiBold" />
                            <TextBox x:Name="SizeNameTextBox" Text="Único" ToolTip="Nome do tamanho" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="HeightTextBox" Grid.Column="0" Text="Altura" Foreground="{StaticResource MutedBrush}" ToolTip="Altura em cm" GotFocus="MeasureTextBox_GotFocus" LostFocus="MeasureTextBox_LostFocus" PreviewTextInput="MeasureTextBox_PreviewTextInput" />
                                <TextBox x:Name="WidthTextBox" Grid.Column="2" Text="Largura" Foreground="{StaticResource MutedBrush}" ToolTip="Largura em cm" GotFocus="MeasureTextBox_GotFocus" LostFocus="MeasureTextBox_LostFocus" PreviewTextInput="MeasureTextBox_PreviewTextInput" />
                                <TextBox x:Name="DepthTextBox" Grid.Column="4" Text="Comprimento" Foreground="{StaticResource MutedBrush}" ToolTip="Comprimento em cm" GotFocus="MeasureTextBox_GotFocus" LostFocus="MeasureTextBox_LostFocus" PreviewTextInput="MeasureTextBox_PreviewTextInput" />
                            </Grid>
                            <Button Content="ADICIONAR TAMANHO" Click="AddSizeButton_Click" Margin="0,0,0,10" />
                            <ListBox x:Name="SizesListBox" Height="92" Margin="0,0,0,14">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="2,3">
                                            <Button DockPanel.Dock="Right" Content="REMOVER" Tag="{Binding}" Click="RemoveSizeButton_Click" Padding="10,5" Margin="10,0,0,0" />
                                            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="Arquivo de impressão 3D *" FontWeight="SemiBold" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ModelPathTextBox"
                                         IsReadOnly="True"
                                         Margin="0" />
                                <Button Grid.Column="1"
                                        Content="Selecionar"
                                        Margin="10,0,0,0"
                                        Click="SelectModelButton_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="22">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="GALERIA"
                                       Foreground="#D98DFF"
                                       FontSize="10"
                                       FontWeight="Bold" />
                            <TextBlock Grid.Row="1"
                                       Text="Adicione até 9 imagens para o anúncio."
                                       Margin="0,7,0,15"
                                       Foreground="{StaticResource MutedBrush}" />

                            <ListBox Grid.Row="2" x:Name="ImagesListBox">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="24" Height="24"
                                                    CornerRadius="7"
                                                    Background="{StaticResource AccentGradient}">
                                                <TextBlock Text="{Binding Position}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontWeight="Bold" />
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding FileName}"
                                                       Margin="9,0,0,0"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding FileSize}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="10" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="3"
                                        Orientation="Horizontal"
                                        Margin="0,14,0,0">
                                <Button Content="+ Adicionar imagens"
                                        Click="SelectImagesButton_Click" />
                                <Button Content="Limpar"
                                        Margin="10,0,0,0"
                                        Click="ClearImagesButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="3"
                Background="#100D1B"
                BorderBrush="#30254A"
                BorderThickness="0,1,0,0"
                Padding="28,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTextBlock"
                               Text="Preencha os dados para começar."
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="ApplicationVersionTextBlock"
                               Margin="18,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Margin="18,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}">
                        <Run Text="Desenvolvido por " />
                        <Hyperlink NavigateUri="https://www.linkedin.com/in/franccesco-felipe-rodrigues"
                                   RequestNavigate="DeveloperLink_RequestNavigate"
                                   Foreground="#D98DFF"
                                   TextDecorations="{x:Null}">
                            <Run Text="Franccesco Felipe" />
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Panel.ZIndex="10">
                    <Button Content="LIMPAR FORMULÁRIO"
                            Margin="0,0,10,0"
                            Click="ClearFormButton_Click" />
                    <Button Content="PREPARAR PRODUTO"
                            Style="{StaticResource PrimaryButton}"
                            Click="PrepareProductButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
